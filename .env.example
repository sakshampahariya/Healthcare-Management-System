FLASK_APP=run.py
FLASK_ENV=development

DATABASE_URL=postgresql+psycopg://postgres@localhost:5432/healthcare
TEST_DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/healthcare_test

JWT_SECRET_KEY=change-me

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# SUCCESS | FAILED | RANDOM — used when the payment request omits simulate_result
PAYMENT_SIMULATE_RESULT=SUCCESS

# ── Email (Flask-Mail / SMTP) ─────────────────────────────────────────────────
# Gmail example: set MAIL_SERVER=smtp.gmail.com, MAIL_PORT=587, MAIL_USE_TLS=true
# Use an App Password if you have 2FA enabled on Gmail
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=your-email@gmail.com
# Set to true to suppress sending (useful in development without SMTP)
MAIL_SUPPRESS_SEND=false
